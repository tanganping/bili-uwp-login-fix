+            HashCore(buffer2, 0, 8);
+            Encode(output, 0, _state, 0, 0x10);
+            _count[0] = _count[1] = 0;
+            _state[0] = 0;
+            _state[1] = 0;
+            _state[2] = 0;
+            _state[3] = 0;
+            Initialize();
+            return output;
+        }
