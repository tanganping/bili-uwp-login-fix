+            IEnumerable<string> backupUrls,
+            int bandwidth,
+            string mimeType,
+            string codecs,
+            int width,
+            int height,
+            string initialization,
+            string indexRange,
+            int startWithSap = 1)
+        {
+            Id = id;
+            BaseUrl = baseUrl;
+            BackupUrls = backupUrls;
+            Bandwidth = bandwidth;
+            MimeType = mimeType;
+            Codecs = codecs;
+            Width = width;
+            Height = height;
+            Initialization = initialization;
+            IndexRange = indexRange;
+            StartWithSap = startWithSap;
