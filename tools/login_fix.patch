+                    if (volume > 100)
+                    {
+                        volume = 100;
+                    }
+                    else if (volume < 0)
+                    {
+                        volume = 0;
+                    }
+
+                    ViewModel.ChangeVolumeCommand.Execute(volume);
+                }
+                else
+                {
+                    var progress = _manipulationProgress + (_manipulationDeltaX * _manipulationUnitLength);
+                    if (progress > ViewModel.DurationSeconds)
+                    {
+                        progress = ViewModel.DurationSeconds;
