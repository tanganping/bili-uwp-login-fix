+        /// </summary>
+        public VideoPartitionDetailPage() => InitializeComponent();
+
+        /// <inheritdoc/>
+        protected override void OnNavigatedTo(NavigationEventArgs e)
+        {
+            if (e.Parameter != null && e.Parameter is Partition partition)
+            {
+                ViewModel.SetPartition(partition);
+            }
