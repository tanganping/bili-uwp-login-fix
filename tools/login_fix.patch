+                        {
+                            if (!subtitleRendered)
+                            {
+                                _render.RenderDanmakuItem(DanmakuDefaultLayerDef.SubtitleLayerId, _danmakuList[_subtitleIndexAfterSeek]);
+                            }
+                            _subtitleIndexAfterSeek = -1;
+                        }
+                    }
+                }
+            }
+            catch (Exception ex)
+            {
+                Logger.Log(ex.Message);
+            }
+            finally
+            {
+                Logger.Log("Exited");
+            }
+        }
+    }
