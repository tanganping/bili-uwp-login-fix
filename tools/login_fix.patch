+        {
+            if (ViewModel.Status == PlayerStatus.NotLoad || ViewModel.Status == PlayerStatus.Buffering)
+            {
+                return;
+            }
+
+            _manipulationProgress = ViewModel.ProgressSeconds;
+            _manipulationVolume = ViewModel.Volume;
+
+            // 点击事件先于手势事件，当该事件触发时，可能已经切换了播放状态.
