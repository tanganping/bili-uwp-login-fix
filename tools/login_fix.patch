+        {
+            var isVip = _accountViewModel.IsVip;
+            if (isVip)
+            {
+                foreach (var item in _mediaInformation.Formats)
+                {
+                    item.IsLimited = false;
+                }
+            }
+
+            foreach (var item in _mediaInformation.Formats)
+            {
+                if (!item.IsLimited)
+                {
+                    Formats.Add(item);
