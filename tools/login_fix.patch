+        {
+            foreach (var item in set.Items)
+            {
+                var folderVM = Locator.Instance.GetService<IVideoFavoriteFolderViewModel>();
+                folderVM.SetFolder(item, this);
+                Items.Add(folderVM);
+            }
+
+            IsEmpty = Items.Count == 0;
+            HasMore = Items.Count < set.TotalCount;
+        }
+    }
