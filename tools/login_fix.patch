+        /// </remarks>
+        public IEnumerable<RoleProfile> Collaborators { get; }
+
+        /// <summary>
+        /// 视频描述.
+        /// </summary>
+        public string Description { get; }
+
+        /// <summary>
+        /// 视频副标题.
+        /// </summary>
+        public string Subtitle { get; }
+
+        /// <summary>
+        /// 高亮文本.
+        /// </summary>
+        /// <remarks>
