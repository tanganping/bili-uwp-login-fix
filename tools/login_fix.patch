+
+            if (response.Content.Headers.ContainsKey("Content-Type"))
+            {
+                ContentType = response.Content.Headers["Content-Type"];
+            }
+
+            _inputStream = await response.Content.ReadAsInputStreamAsync().AsTask().ConfigureAwait(false);
