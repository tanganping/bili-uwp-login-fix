+                                            break;
+                                        }
+                                    case DanmakuMode.Top:
+                                        {
+                                            layerId = DanmakuDefaultLayerDef.TopLayerId;
+                                            break;
+                                        }
+                                    case DanmakuMode.ReverseRolling:
+                                        {
+                                            layerId = DanmakuDefaultLayerDef.ReverseRollingLayerId;
+                                            break;
+                                        }
+                                    case DanmakuMode.Advanced:
