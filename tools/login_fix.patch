-
-            private static void Merge(IList<DanmakuItem> list, int p, int r)
-            {
-                if (p < r)
-                {
-                    int mid = (p + r) / 2;
-                    Merge(list, p, mid);
-                    Merge(list, mid + 1, r);
-                    MergeArray(list, p, mid, r);
-                }
-            }
-
-            private static void MergeArray(IList<DanmakuItem> list, int p, int mid, int r)
