+            => _livePageNumber = 1;
+
+        /// <inheritdoc/>
+        public void ClearStatus()
+        {
+            ResetComprehensiveStatus();
+            ResetAnimeStatus();
+            ResetArticleStatus();
+            ResetLiveStatus();
+            ResetMovieStatus();
+            ResetUserStatus();
